{
	"name": "7flows.studio",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint",
		"test": "playwright test",
		"test:landing": "playwright test landing.spec.ts",
		"test:ui": "playwright test --ui",
		"test:perf": "playwright test landing.spec.ts --grep 'performance'",
		"test:chromium": "playwright test --project=chromium",
		"test:firefox": "playwright test --project=firefox",
		"test:webkit": "playwright test --project=webkit",
		"test:mobile": "playwright test --project='Mobile Chrome'",
		"test:debug": "playwright test --debug",
		"test:headed": "playwright test --headed",
		"test:standalone": "node tests/landing.spec.ts",
		"test:bash": "./tests/run-tests.sh",
		"test:quick": "node tests/quick-check.js",
		"test:install": "playwright install",
		"test:report": "playwright show-report"
	},
	"dependencies": {
		"@reduxjs/toolkit": "^2.8.2",
		"axios": "^1.11.0",
		"clsx": "^2.1.1",
		"deepmerge-ts": "^7.1.5",
		"formik": "^2.4.6",
		"next": "^16.0.7",
		"next-intl": "^4.5.8",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"react-hot-toast": "^2.6.0",
		"react-redux": "^9.2.0",
		"react-toastify": "^11.0.5",
		"redux": "^5.0.1",
		"redux-persist": "^6.0.0",
		"swiper": "^11.2.10",
		"types": "^0.1.1",
		"yup": "^1.7.0"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3",
		"@playwright/test": "^1.58.0",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9",
		"eslint-config-next": "15.5.0",
		"typescript": "^5"
	}
}
